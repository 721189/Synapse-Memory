# ─────────────────────────────────────────────────────────────────────────────
# SynapseMemory — Node Gateway image (dashboard + API gateway)
# Serves the React dashboard and proxies /query, /feedback, /ingest, etc.
# to the separate Python engine service. Lightweight: Node only, no Python/ML.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-slim AS base

# tini for proper PID 1 signal handling + graceful shutdown in k8s/compose.
RUN apt-get update && apt-get install -y --no-install-recommends tini curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies from lockfile for reproducible builds.
COPY package.json package-lock.json ./
RUN npm ci

# Build the Vite dashboard + server bundle.
COPY tsconfig.json vite.config.ts index.html ./
COPY server.ts ./
COPY demo ./demo
COPY src ./src
RUN npm run build && npm prune --omit=dev

# Run as a non-root user.
RUN groupadd --system synapse && useradd --system --gid synapse --home /app synapse \
    && chown -R synapse:synapse /app
USER synapse

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3000/api/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/server.cjs"]

# ─────────────────────────────────────────────────────────────────────────────
# SynapseMemory — Node Gateway image (dashboard + API gateway)
# Serves the React dashboard and proxies /query, /feedback, /ingest, etc.
# to the separate Python engine service. Lightweight: Node only, no Python/ML.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-slim AS base

# tini for proper PID 1 signal handling + graceful shutdown in k8s/compose.
# No curl: the healthcheck uses Node's built-in fetch. Upgrade the Debian base
# packages so security fixes published after the base image was built actually
# land — Trivy gates on fixable CVEs.
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies from lockfile for reproducible builds.
COPY package.json package-lock.json ./
RUN npm ci

# Build the Vite dashboard + server bundle.
COPY tsconfig.json vite.config.ts index.html ./
COPY server.ts ./
COPY demo ./demo
COPY src ./src
RUN npm run build && npm prune --omit=dev

# Run as a non-root user.
RUN groupadd --system synapse && useradd --system --gid synapse --home /app synapse \
    && chown -R synapse:synapse /app
USER synapse

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/server.cjs"]

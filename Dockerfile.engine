# ─────────────────────────────────────────────────────────────────────────────
# SynapseMemory — Python Cognitive Engine image (FastAPI + pgvector)
# The real memory substrate: hybrid retrieval, Ebbinghaus decay, knapsack
# packing, encryption, multi-tenant RBAC. Deploy as its own service; the Node
# gateway proxies to it over SYNAPSE_ENGINE_URL.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/sdk/python \
    PIP_NO_CACHE_DIR=1

# No curl: the healthcheck below uses Python's stdlib, and avoiding the extra
# package keeps a libcurl CVE out of the scanned image surface (F-04 follow-up).
WORKDIR /app

# Install the engine + production dependencies (pgvector driver).
# The default embedding provider is deterministic hash (no external deps),
# so the image starts without sentence-transformers.
# To use local neural embeddings, build with:
#   DOCKER_BUILDKIT=1 docker build --build-arg INSTALL_LOCAL_MODELS=true -f Dockerfile.engine .
ARG INSTALL_LOCAL_MODELS=false
COPY sdk/python ./sdk/python
# Provisioning/migration entrypoint used by the compose `db-provision` one-shot
# service and by operators running against a managed database (F-04).
COPY scripts ./scripts
RUN pip install --no-cache-dir -e "sdk/python[pgvector]" \
    && if [ "$INSTALL_LOCAL_MODELS" = "true" ]; then \
         pip install --no-cache-dir -e "sdk/python[local-models]"; \
       fi

# Non-root runtime.
RUN groupadd --system synapse && useradd --system --gid synapse --home /app synapse \
    && mkdir -p /data && chown -R synapse:synapse /app /data
USER synapse

ENV SYNAPSE_SQLITE_DB_PATH=/data/synapse_memory.db
EXPOSE 8008

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8008/liveness', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "synapse_memory.api.fastapi_server:app", "--host", "0.0.0.0", "--port", "8008"]

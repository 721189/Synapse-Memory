{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Memories Indexed",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_memories_total", "legendFormat": "{{backend}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Engine Up",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bool", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_up", "legendFormat": "up", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Embedding Dimension",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_embedding_dimension", "legendFormat": "dims", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate Limiter Backend",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_rate_limit_backend", "legendFormat": "{{backend}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests / sec by endpoint",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (path) (rate(synapse_requests_total[5m]))", "legendFormat": "{{path}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 Request Latency (seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "expr": "synapse_request_latency_seconds{quantile=\"0.95\"}", "legendFormat": "{{path}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Auth Failures & Rate-Limit Rejections",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "expr": "synapse_auth_failures_total", "legendFormat": "auth failures", "refId": "A" },
        { "expr": "synapse_rate_limit_rejections_total", "legendFormat": "rate-limit 429s", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ingest & Retrieval Volume",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        { "expr": "synapse_ingest_total{outcome=\"success\"}", "legendFormat": "ingest ok", "refId": "A" },
        { "expr": "synapse_retrieval_total{outcome=\"success\"}", "legendFormat": "retrieval ok", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "DB Pool Utilization",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 20, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 18 }] } },
        "overrides": []
      },
      "options": { "showThresholdLabels": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_db_pool_in_use", "legendFormat": "in use", "refId": "A" },
        { "expr": "synapse_db_pool_size", "legendFormat": "size", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Context Tokens Packed (last retrieval)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_context_tokens_packed", "legendFormat": "tokens", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Retrieval Candidates (last)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "synapse_retrieval_candidates", "legendFormat": "candidates", "refId": "A" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["synapse-memory", "rag", "memory"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Synapse Memory",
  "uid": "synapse-memory",
  "version": 1
}

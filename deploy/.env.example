# ─────────────────────────────────────────────────────────────────────────────
# SynapseMemory — Deployment Environment Variables
# This is the SINGLE SOURCE OF TRUTH for configuration. Copy to `.env` in the
# deploy/ directory and fill in secure values before `docker compose up`.
#
#   cp deploy/.env.example deploy/.env   &&   edit deploy/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Engine authentication ────────────────────────────────────────────────────
# Root API key bootstrapped into the engine on first start (hashed at rest).
# REQUIRED. Generate one: python -c "import secrets; print('syn_live_'+secrets.token_hex(24))"
SYNAPSE_API_KEY=

# Data-at-rest master key (Fernet). Must be a URL-safe base64 32-byte key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production, source this from KMS/Vault instead of a plaintext file.
SYNAPSE_ENCRYPTION_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# pgvector = team/production (Postgres). sqlite = single-node local dev only.
SYNAPSE_STORAGE_BACKEND=pgvector

# SQLite file path (only used when SYNAPSE_STORAGE_BACKEND=sqlite or no DATABASE_URL).
SYNAPSE_SQLITE_DB_PATH=/data/synapse_memory.db

# Bootstrap database superuser. Used only to install extensions and manage roles.
# It must remain distinct from SYNAPSE_DB_ADMIN_ROLE (the non-superuser migrator).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=synapse_cognitive

# ── Least-privilege runtime role (PostgreSQL / pgvector only) ────────────────
# Recommended production topology, "migrate-then-run": a migration role owns the
# schema and a DML-only runtime role serves traffic that cannot bypass RLS.
# Bootstrap credentials and migration/runtime roles are intentionally separate.
# Compose installs required extensions and provisions the roles using
# POSTGRES_USER / POSTGRES_PASSWORD; schema DDL runs through the migration role.
# Set three independent strong passwords: bootstrap, migration, and runtime.
SYNAPSE_APP_DATABASE_URL=
SYNAPSE_APP_DB_PASSWORD=
SYNAPSE_ADMIN_DB_PASSWORD=
SYNAPSE_DB_RUNTIME_ROLE=synapse_app
SYNAPSE_DB_ADMIN_ROLE=synapse_admin
# NOTE: `docker compose up` constructs the bootstrap and migration DSNs and
# runs the provisioning sequence from an empty database volume.

# true = engine creates/upgrades its own schema (single-role dev ONLY: the role
#        in DATABASE_URL must own the schema).
# false = migrate-then-run: DDL is done ahead of start-up by the admin role.
# Production (runtime role is a NON-owner) REQUIRES false — the runtime role
# would fail the DDL and the engine would fail closed at startup.
SYNAPSE_APPLY_DB_SCHEMA=false

# Fail-closed: when a DATABASE_URL is set, refuse to silently fall back to
# in-memory storage (which loses data on restart). Set true ONLY for local dev.
SYNAPSE_ALLOW_DB_FALLBACK=false

# ── Demo / simulated routes ──────────────────────────────────────────────────
# MUST be false in production. Disables infrastructure/licensing/dreaming/etc.
# demo endpoints that are not backed by the real cognitive engine.
ENABLE_DEMO_ROUTES=false

# ── Gateway / engine networking ──────────────────────────────────────────────
NODE_ENV=production
GATEWAY_PORT=3000
ENGINE_PORT=8008
PYTHON_ENGINE_URL=http://127.0.0.1:8008

# Comma-separated allowed CORS origins for the dashboard.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Redis (query cache + distributed rate limiting) ──────────────────────────
REDIS_PASSWORD=

# Distributed rate limiting. When set, per-key limits are enforced across
# ALL engine replicas via a Redis sorted-set sliding window. Leave blank for
# the single-instance in-process limiter.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis-state:6379/0

# ── Tuning ───────────────────────────────────────────────────────────────────
TOKEN_BUDGET_MAX=1500
RATE_LIMIT_PER_MIN=120
SYNAPSE_MAX_RECORD_LIMIT=50

# ── Optional: LLM embedding providers ────────────────────────────────────────
SYNAPSE_EMBEDDING_PROVIDER=gemini        # REQUIRED: gemini | openai | sentence-transformers. The deterministic hash provider is refused in production.
# SYNAPSE_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SYNAPSE_EMBEDDING_DIMENSION=384
GEMINI_API_KEY=
OPENAI_API_KEY=

GATEWAY_VERSION=v1.3.1

# SynapseMemory Production Deployment Environment Variables
# Copy to .env and replace with secure values before launching

# Gemini AI API Key (Required)
GEMINI_API_KEY=

# Synapse Authenticated Data-at-Rest Master Key (Base64 32-byte key)
SYNAPSE_ENCRYPTION_KEY=

# PostgreSQL with pgvector configuration
POSTGRES_USER=synapse_admin
POSTGRES_PASSWORD=
POSTGRES_DB=synapse_cognitive

# Redis authentication
REDIS_PASSWORD=

# Gateway Configuration
GATEWAY_PORT=3000
TOKEN_BUDGET_MAX=1500
HYBRID_DECAY_RATE=0.08
GATEWAY_VERSION=v1.2.0
